<phone:PhoneApplicationPage 
    x:Class="MarkInDeDark.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="c:\users\francesco\documents\visual studio 2012\Projects\MarkInDeDark\MarkInDeDark\MarkInDeDark\GamePage.xamlhttp://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SupportedOrientations="Landscape" Orientation="Landscape"
    mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="480"
     xmlns:vm="clr-namespace:MarkInDeDark.ViewModel"
    BackKeyPress="PhoneApplicationPage_BackKeyPress"
    shell:SystemTray.IsVisible="False">

    <!--Nessun contenuto XAML è richiesto poiché il rendering della pagina viene eseguito interamente con XNA Framework-->
    <phone:PhoneApplicationPage.Resources>
        <vm:ViewModelLocator x:Key="MainViewModel" />
    </phone:PhoneApplicationPage.Resources>
    
    <Grid>

        <!-- Animazioni Overlay -->
        
        <Grid.Resources>
           
            <Storyboard x:Name="PauseAnimationFadeOut">
                <DoubleAnimation Storyboard.TargetName="PauseOverlay"
                             Storyboard.TargetProperty="Opacity" 
                             From="0.5" To="0" Duration="0:0:0.1" />
                <ObjectAnimationUsingKeyFrames BeginTime="0:0:1" Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="PauseOverlay">
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value>
                            <Visibility>Collapsed</Visibility>
                        </DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
            
            <Storyboard x:Name="PauseAnimationFadeIn">
                <DoubleAnimation Storyboard.TargetName="PauseOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.5" Duration="0:0:0.3" />
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="PauseOverlay">
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value>
                            <Visibility>Visible</Visibility>
                        </DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Name="GameOverAnimationFadeIn">
                <DoubleAnimation Storyboard.TargetName="GameOverOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3" />
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="GameOverOverlay">
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value>
                            <Visibility>Visible</Visibility>
                        </DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Name="WinAnimationFadeIn">
                <DoubleAnimation Storyboard.TargetName="WinOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.5" Duration="0:0:0.3" />
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="WinOverlay">
                    <DiscreteObjectKeyFrame KeyTime="0">
                        <DiscreteObjectKeyFrame.Value>
                            <Visibility>Visible</Visibility>
                        </DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>


        </Grid.Resources>
        
        <!-- / Animazioni Overlay -->


        <Grid x:Name="PauseOverlay"    
              Visibility="Visible"  
              Background="LightGray"    
              Opacity="0.5" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Path=T.GamePausa, Source={StaticResource LocalizedStrings}}" FontSize="90" FontFamily="Segoe UI Light" 
                       Margin="20" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="#FFFF3333"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="Exit" Background="Crimson" 
                        Margin="30,120" Grid.Column="0" Content="{Binding Path=T.GameEsci, Source={StaticResource LocalizedStrings}}" Click="Exit_Click_1" BorderBrush="{x:Null}" />
                <Button x:Name="Continue" Background="Crimson" 
                        Margin="30,120" Grid.Column="1" Content="Riprendi" Click="Continue_Click_1" BorderBrush="{x:Null}" />
                <Button x:Name="Replay" Background="Crimson" 
                        Margin="30,120" Grid.Column="2" Content="{Binding Path=T.GameRiprova, Source={StaticResource LocalizedStrings}}" Click="PlayAgain_Click" BorderBrush="{x:Null}" />
            </Grid>
        </Grid>

        <Grid x:Name="GameOverOverlay"    
              Visibility="Visible"  
              Background="Black"
              Opacity="1.0" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Game over" FontSize="90" FontFamily="Segoe UI Light"
                       Margin="20" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="#FFFF3333"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="Exit2" Background="Crimson" Margin="50,100" Grid.Column="0" Content="{Binding Path=T.GameEsci, Source={StaticResource LocalizedStrings}}" Click="Exit_Click_1" BorderBrush="{x:Null}" />
                <Button x:Name="PlayAgain" Background="Crimson"  Margin="50,100" Grid.Column="1" Content="{Binding Path=T.GameRiprova, Source={StaticResource LocalizedStrings}}" Click="PlayAgain_Click" BorderBrush="{x:Null}" />
            </Grid>
        </Grid>

        <Grid x:Name="WinOverlay"    
              Visibility="Visible"  
              Background="Black"    
              Opacity="1.0" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Path=T.GameLivelloSuperato, Source={StaticResource LocalizedStrings}}" FontSize="90" FontFamily="Segoe UI Light" Margin="20" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="#FFFF3333"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="TornaAiLivelli" Background="Crimson" Margin="50,100" Grid.Column="0" Content="{Binding Path=T.LivelliTitolo, Source={StaticResource LocalizedStrings}}" Click="Livelli_Click" BorderBrush="{x:Null}" />
                <Grid Margin="65, 115" Grid.Column="1" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Foreground="White" FontSize="20">
                        <Run>&#x1f484; </Run>
                        <Run x:Name="CandeleUsate"> X</Run>
                    </TextBlock>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Foreground="White" FontSize="20" >
                        <Run>⏰ </Run>
                        <Run x:Name="TempoImpiegato"> X</Run>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>

    </Grid>


</phone:PhoneApplicationPage>
