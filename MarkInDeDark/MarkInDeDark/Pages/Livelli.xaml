<phone:PhoneApplicationPage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MarkInDeDark"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:UI="clr-namespace:Microsoft.Advertising.Mobile.UI;assembly=Microsoft.Advertising.Mobile.UI"
    x:Class="MarkInDeDark.Pages.Livelli"
    SupportedOrientations="Landscape" Orientation="Landscape"
    mc:Ignorable="d"
    xmlns:vm="clr-namespace:MarkInDeDark.ViewModel"
    xmlns:localConverters="clr-namespace:MarkInDeDark.ViewModel.Converters"
    shell:SystemTray.IsVisible="False">
    


    <phone:PhoneApplicationPage.Resources>

        <Style x:Key="TransitionPageStyle" TargetType="phone:PhoneApplicationPage">
            <Setter Property="toolkit:TransitionService.NavigationInTransition">
                <Setter.Value>
                    <toolkit:NavigationInTransition>
                        <toolkit:NavigationInTransition.Backward>
                            <toolkit:SlideTransition  Mode="SlideDownFadeIn"/>
                        </toolkit:NavigationInTransition.Backward>
                        <toolkit:NavigationInTransition.Forward>
                            <toolkit:SlideTransition Mode="SlideRightFadeIn"/>
                        </toolkit:NavigationInTransition.Forward>
                    </toolkit:NavigationInTransition>
                </Setter.Value>
            </Setter>
        </Style>


        <vm:ViewModelLocator x:Key="MainViewModel" />
        <localConverters:BindingBoolToColorConverter x:Key="BoolToColor" />
        <localConverters:BindingBoolToVisibilityConverter x:Key="BoolToVisibility" />
        <localConverters:BindingMinutesToTimeSpanConverter x:Key="IntToMinutes" />

        <Style TargetType="TextBlock" x:Name="LivelliTextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <!--LayoutRoot è la griglia radice in cui viene inserito tutto il contenuto della pagina-->
    <Grid x:Name="LayoutRoot" Background="LightGray"  DataContext="{Binding Source={StaticResource MainViewModel}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image 
            Grid.Row="0" Grid.RowSpan="3"
            Source="/Assets/Backgrounds/background1.jpg" />

        <Image Source="/Assets/MarkLogo.png" Stretch="Uniform" Width="100" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <TextBlock Text="{Binding Path=T.LivelliTitolo, Source={StaticResource LocalizedStrings}}" FontSize="90" FontFamily="Segoe UI Light" Margin="0" 
                   VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="White"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="listBoxLevels" ItemsSource="{Binding Main.Levels.LevelsList}"
                 HorizontalAlignment="Center"
                 Grid.Column="1"  Foreground="White" SelectionChanged="listBoxLevels_SelectionChanged">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="2" Background="Black" Opacity="0.8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="25"></RowDefinition>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0" Padding="5,0,5,0" Text="✔" FontSize="15" VerticalAlignment="Center" Visibility="{Binding HasSecret.Value, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" />
                                <TextBlock FontWeight="Light" Grid.Column="1" Text="{Binding TextToShow}" Style="{StaticResource LivelliTextBlock}" />
                            </Grid>

                            <Grid Background="Crimson" Grid.Row="1" Visibility="{Binding Completed.Value, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0"  Padding="5,0,5,0" Text="&#x1f484;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" />
                                <TextBlock Grid.Column="1" Text="{Binding RecordUsedCandles.Value}" Style="{StaticResource LivelliTextBlock}" />
                            </Grid>

                            <Grid Background="Crimson" Grid.Row="2" Visibility="{Binding Completed.Value, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0"  Padding="5,0,5,0" Text="⏰" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" />
                                <TextBlock Grid.Column="1" Text="{Binding RecordCompletionMinutes.Value, Converter={StaticResource IntToMinutes}}" Style="{StaticResource LivelliTextBlock}" />
                            </Grid>

                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <toolkit:WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ListBox>

        </Grid>

        <UI:AdControl x:Name="Advertisement" Grid.Row="2" ApplicationId="cb26d34c-fe85-4fda-abc9-ee0f402711dd" AdUnitId="219033" Width="480" Height="80" />

    </Grid>


</phone:PhoneApplicationPage>