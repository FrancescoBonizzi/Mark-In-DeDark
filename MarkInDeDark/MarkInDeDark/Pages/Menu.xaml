<phone:PhoneApplicationPage 
    x:Class="MarkInDeDark.Pages.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:UI="clr-namespace:Microsoft.Advertising.Mobile.UI;assembly=Microsoft.Advertising.Mobile.UI"
    mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="800"
    SupportedOrientations="Landscape" Orientation="Landscape"
    xmlns:vm="clr-namespace:MarkInDeDark.ViewModel"
    Style="{StaticResource TransitionPageStyle}"
    shell:SystemTray.IsVisible="False">

    <phone:PhoneApplicationPage.Resources>
        <vm:ViewModelLocator x:Key="MainViewModel" />
    </phone:PhoneApplicationPage.Resources>

    <!--LayoutRoot è la griglia radice in cui viene inserito tutto il contenuto della pagina-->
    <Grid DataContext="{Binding Source={StaticResource MainViewModel}}" x:Name="LayoutRoot" Background="Transparent">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="210"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Image
            Grid.Row="0" Grid.RowSpan="3"
            Source="/Assets/Backgrounds/background4.jpg" />

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

     
                <Image Grid.Column="1"  Source="/Assets/MarkLogo.png" Stretch="Uniform" Width="150" Margin="00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"  x:Name="TextBlockVersione" Text="Versione" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="100,0,0,0" FontFamily="Segoe UI Light" Foreground="White" FontSize="24" />
  

        </Grid>

        <Grid x:Name="ContentPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="buttonPlay" Padding="20,0" Grid.Row="0" Grid.Column="1" FontFamily="Segoe UI Light" FontSize="22" Content="{Binding Path=T.MenuGioca, Source={StaticResource LocalizedStrings}}" Click="ButtonPlay_Click" 
                    Background="#FFFF2929" MinWidth="200" Opacity="0.8" BorderBrush="{x:Null}" Height="70" />
            <Button x:Name="buttonShop" Padding="20,0" Grid.Row="2" Opacity="0.8" Grid.Column="1" FontFamily="Segoe UI Light" FontSize="22" Content="{Binding Path=T.MenuGiocoCompleto, Source={StaticResource LocalizedStrings}}" Click="buttonShop_Click" 
                    Background="#FF383838" MinWidth="200" BorderBrush="{x:Null}" Height="70" />

            <toolkit:ToggleSwitch x:Name="ToggleSoundSwitch" Header="{Binding Path=T.MenuSuoni, Source={StaticResource LocalizedStrings}}"
                                  Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" SwitchForeground="Crimson" 
                                  Content="SN" Checked="ToggleSoundSwitch_Checked" Unchecked="ToggleSoundSwitch_Unchecked"
                                  IsChecked="{Binding Main.SoundEnabled, Mode=TwoWay}" 
                                  Width="199"/>
            <Button x:Name="buttonAbout" MinWidth="200" Padding="20,0" Grid.Row="1" Opacity="0.8" Grid.Column="1" FontFamily="Segoe UI Light" FontSize="22" Content="{Binding Path=T.MenuAbout, Source={StaticResource LocalizedStrings}}" Click="ButtonAbout_Click"
                       Background="Black" BorderBrush="{x:Null}" Height="70" />
            
        </Grid>

        <UI:AdControl x:Name="Advertisement" Grid.Row="2" ApplicationId="cb26d34c-fe85-4fda-abc9-ee0f402711dd" AdUnitId="219033" Width="480" Height="80" />

    </Grid>

</phone:PhoneApplicationPage>