<Window
    x:Class="MarkInDeDark.LevelEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mark in DeDark - Level editor"
    PreviewKeyDown="LevelEditorCanvas_PreviewKeyDown"
    ResizeMode="CanMinimize"
    Width="1000"
    Closing="Window_Closing"
    mc:Ignorable="d">

    <DockPanel Background="AliceBlue">

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="File">
                <MenuItem
                    x:Name="btnNuovo"
                    Click="BtnNuovo_Click"
                    Header="Nuovo" />
                <Separator />
                <MenuItem
                    x:Name="btnApri"
                    Click="BtnApri_Click"
                    Header="Apri" />
                <Separator />
                <MenuItem
                    x:Name="btnSalva"
                    Click="BtnSalva_Click"
                    Header="Salva" />
                <MenuItem
                    x:Name="btnSalvaCopia"
                    Click="BtnSalvaCopia_Click"
                    Header="Salva una copia" />
                <Separator />
                <MenuItem
                    x:Name="btnImpostaPathGioco"
                    Click="BtnImpostaPathGioco_Click"
                    Header="Imposta percorso del gioco" />
            </MenuItem>

            <MenuItem Header="Strumenti">
                <MenuItem
                    x:Name="btnProvaInGame"
                    Click="BtnProvaInGame_Click"
                    Header="Prova in game" />
                <MenuItem
                    x:Name="btnCambiaSettingsGioco"
                    Click="BtnCambiaSettingsGioco_Click"
                    Header="Cambia impostazioni di gioco" />
            </MenuItem>

        </Menu>

        <ToolBar
            DockPanel.Dock="Top"
            ToolBar.OverflowMode="Never"
            ToolBarTray.IsLocked="True">

            <StackPanel Orientation="Vertical">

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="60"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Terreno: " />

                    <Button
                        x:Name="helpGround"
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpGround_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        x:Name="btnBuio"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Disegna una cella buia. Cliccando di destro col mouse nella griglia si ottiene lo stesso effetto">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Black" />
                            <TextBlock Padding="2,2" Text="Buio" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnGroundType_Ground"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Disegna una cella sui il personaggio può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Brown" />
                            <TextBlock Padding="2,2" Text="Terra" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="2"
                        ToolTip="Disegna una cella sui il personaggio non può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="White" />
                            <TextBlock Padding="2,2" Text="Maceria" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="3"
                        ToolTip="Imposta una trappola a morte istantanea">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Fuchsia" />
                            <TextBlock Padding="2,2" Text="Trappola ist." />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="4"
                        ToolTip="Imposta una trappola con botola">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Aqua" />
                            <TextBlock Padding="2,2" Text="Trappola dt" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="5"
                        ToolTip="Trigger per far apparire il Goblin">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Lime" />
                            <TextBlock Padding="2,2" Text="Goblin trigger" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="60"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Muri: " />

                    <Button
                        x:Name="helpWalls"
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpWalls_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Cancella il muro">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Black" />
                            <TextBlock Padding="2,2" Text="No muro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Disegna un muro che non potrà essere oltrepassato">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Green" />
                            <TextBlock Padding="2,2" Text="Muro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="2"
                        ToolTip="Disegna un muro che potrà essere essere distrutto">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Red" />
                            <TextBlock Padding="2,2" Text="Muro fragile" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="60"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Oggetti: " />

                    <Button
                        x:Name="helpObjects"
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpObjects_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Cancella oggetto">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Black" />
                            <TextBlock Padding="2,2" Text="Cancella" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Player"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Imposta la posizione del giocatore">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/player_front_iddle.png" />
                            <TextBlock Padding="2,2" Text="Giocatore" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Key"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="2"
                        ToolTip="Imposta la posizione della chiave d'uscita">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/key.png" />
                            <TextBlock Padding="2,2" Text="Chiave" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Exit"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="3"
                        ToolTip="Imposta la posizione dell'uscita">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/win_closed.png" />
                            <TextBlock Padding="2,2" Text="Uscita" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="4"
                        ToolTip="Imposta un pacco di candele">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/candle6.png" />
                            <TextBlock Padding="2,2" Text="Candele" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="60"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Nemici: " />

                    <Button
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpEnemies_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        x:Name="BtnObjectType_Zombie"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="5"
                        ToolTip="Imposta la posizione dello zombie">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/zombie_front_walking_1.png" />
                            <TextBlock Padding="2,2" Text="Zombie" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Skeleton"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="6"
                        ToolTip="Imposta la posizione dello scheletro">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/skeleton_front_iddle.png" />
                            <TextBlock Padding="2,2" Text="Scheletro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Goblin"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="7"
                        ToolTip="Imposta la posizione dello scheletro">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/goblin_front_dying_1.png" />
                            <TextBlock Padding="2,2" Text="Goblin" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Taurus"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="8"
                        ToolTip="Imposta la posizione del taurus">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/taurus_front_iddle.png" />
                            <TextBlock Padding="2,2" Text="Taurus" />
                        </StackPanel>
                    </RadioButton>

                    <!--  TODO Aggiungere Wolf con tag 9 -->

                </StackPanel>

            </StackPanel>

        </ToolBar>

        <Grid>

            <Canvas
                Name="levelEditorCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Cursor="Pen"
                MouseDown="LevelEditorCanvas_MouseDown"
                MouseMove="LevelEditorCanvas_MouseMove" />

        </Grid>

    </DockPanel>

</Window>
