<Window
    x:Class="MarkInDeDark.LevelEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mark in DeDark - Level editor"
    Width="1422"
    Height="900"
    PreviewKeyDown="LevelEditorCanvas_PreviewKeyDown"
    ResizeMode="NoResize"
    mc:Ignorable="d">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem
                    x:Name="btnNuovo"
                    Click="BtnNuovo_Click"
                    Header="Nuovo" />
                <Separator />
                <MenuItem
                    x:Name="btnApri"
                    Click="BtnApri_Click"
                    Header="Apri" />
                <Separator />
                <MenuItem
                    x:Name="btnSalva"
                    Click="BtnSalva_Click"
                    Header="Salva" />
            </MenuItem>
        </Menu>

        <ToolBar
            DockPanel.Dock="Top"
            ToolBar.OverflowMode="Never"
            ToolBarTray.IsLocked="True">

            <StackPanel Orientation="Vertical">

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="60"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Terreno: " />

                    <RadioButton
                        x:Name="btnBuio"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Disegna una cella buia. Cliccando di destro col mouse nella griglia si ottiene lo stesso effetto">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Black" />
                            <TextBlock Padding="5,2" Text="Buio" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Disegna una cella sui il personaggio può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Brown" />
                            <TextBlock Padding="5,2" Text="Terra" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="2"
                        ToolTip="Disegna una cella sui il personaggio non può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="White" />
                            <TextBlock Padding="5,2" Text="Maceria" />
                        </StackPanel>
                    </RadioButton>

                    <Button
                        Width="22"
                        Padding="5,2"
                        Cursor="Help"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Content="?"
                        Click="HelpGround_Click"
                        x:Name="helpGround"/>
                    
                </StackPanel>

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="60"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Muri: " />

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Cancella il muro">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Black" />
                            <TextBlock Padding="5,2" Text="No muro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Disegna un muro che non potrà essere oltrepassato">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Green" />
                            <TextBlock Padding="5,2" Text="Muro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="2"
                        ToolTip="Disegna un muro che potrà essere essere distrutto">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Red" />
                            <TextBlock Padding="5,2" Text="Muro fragile" />
                        </StackPanel>
                    </RadioButton>

                    <Button
                        Width="22"
                        Padding="5,2"
                        Cursor="Help"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Content="?"
                        Click="HelpWalls_Click"
                        x:Name="helpWalls"/>

                </StackPanel>

            </StackPanel>

        </ToolBar>

        <Grid>
            <Canvas
                Name="levelEditorCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Cursor="Pen"
                MouseDown="LevelEditorCanvas_MouseDown"
                MouseMove="LevelEditorCanvas_MouseMove" />
        </Grid>

    </DockPanel>

</Window>
