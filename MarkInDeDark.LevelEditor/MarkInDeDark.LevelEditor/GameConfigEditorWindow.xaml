<Window
    x:Class="MarkInDeDark.LevelEditor.GameConfigEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MarkInDeDark.LevelEditor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:myClasses="clr-namespace:MarkInDeDark.Common;assembly=MarkInDeDark.Common"
    xmlns:otherControls="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:xnaClasses="clr-namespace:Microsoft.Xna.Framework;assembly=MonoGame.Framework"
    Title="Configurazione del gioco"
    Width="700"
    Height="750"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:XnaColorToWindowsColor x:Key="XnaColorToWindowsColor" />
        <converters:XnaVector2ToX x:Key="XnaVector2ToX" />
        <converters:XnaVector2ToY x:Key="XnaVector2ToY" />
    </Window.Resources>

    <DockPanel Background="AliceBlue">

        <Grid DockPanel.Dock="Top">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Menu Grid.Row="0">

                <MenuItem Header="File">


                    <MenuItem
                        x:Name="btnSalva"
                        Click="btnSalva_Click"
                        Header="Salva sul gioco corrente"
                        ToolTip="Lo salva direttamente nella configurazione del gioco che hai installato al momento. Si sovrascrive quando aggiorni il gioco!">

                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE105;" />
                        </MenuItem.Icon>

                    </MenuItem>

                    <MenuItem
                        x:Name="btnSalvaInAltroFile"
                        Click="btnSalvaInAltroFile_Click"
                        Header="Salva in un altro file">

                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE159;" />
                        </MenuItem.Icon>

                    </MenuItem>


                </MenuItem>

            </Menu>

            <TextBlock
                Grid.Row="1"
                Padding="6"
                FontWeight="SemiBold"
                Foreground="Red"
                Text="Attenzione! Al prossimo update del gioco perdi queste modifiche se non le salvi in un altro file!" />

        </Grid>

        <otherControls:PropertyGrid
            x:Name="propertyGrid"
            Grid.Row="0"
            Margin="10"
            IsReadOnly="False"
            NameColumnWidth="350"
            ShowSearchBox="False"
            ShowSortOptions="False"
            ShowSummary="False"
            ShowTitle="False">

            <otherControls:PropertyGrid.EditorDefinitions>

                <otherControls:EditorTemplateDefinition TargetProperties="{x:Type xnaClasses:Color}">

                    <otherControls:EditorTemplateDefinition.EditingTemplate>
                        <DataTemplate>
                            <otherControls:ColorPicker SelectedColor="{Binding Value, Converter={StaticResource XnaColorToWindowsColor}}" />
                        </DataTemplate>
                    </otherControls:EditorTemplateDefinition.EditingTemplate>

                </otherControls:EditorTemplateDefinition>

                <otherControls:EditorTemplateDefinition TargetProperties="{x:Type myClasses:ClassVector2}">

                    <otherControls:EditorTemplateDefinition.EditingTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <Label VerticalAlignment="Center" Content="X" />
                                    <TextBox
                                        Width="100"
                                        VerticalAlignment="Center"
                                        DataContext="{Binding Value}"
                                        Text="{Binding X}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label VerticalAlignment="Center" Content="Y" />
                                    <TextBox
                                        Width="100"
                                        VerticalAlignment="Center"
                                        DataContext="{Binding Value}"
                                        Text="{Binding Y}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </otherControls:EditorTemplateDefinition.EditingTemplate>

                </otherControls:EditorTemplateDefinition>

            </otherControls:PropertyGrid.EditorDefinitions>

        </otherControls:PropertyGrid>

    </DockPanel>

</Window>
