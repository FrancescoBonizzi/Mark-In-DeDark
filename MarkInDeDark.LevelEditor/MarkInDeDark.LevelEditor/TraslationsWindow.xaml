<Window
    x:Class="MarkInDeDark.LevelEditor.TraslationsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Traduzioni"
    Width="850"
    Height="450"
    Closing="Window_Closing"
    mc:Ignorable="d">

    <DockPanel Background="AliceBlue">

        <Grid DockPanel.Dock="Top">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Menu Grid.Row="0">

                <MenuItem
                    x:Name="btnSalvaTutto"
                    Click="btnSalvaTutto_Click"
                    Header="Salva sul gioco corrente" />

                <MenuItem
                    x:Name="btnSalvaAltroFile"
                    Click="btnSalvaAltroFile_Click"
                    Header="Salva in un altro file" />

            </Menu>

            <TextBlock
                Grid.Row="1"
                Padding="6"
                FontWeight="SemiBold"
                Foreground="Red"
                Text="Attenzione! TUTTE le volte che finisci un livello devi salvare il file delle traduzioni in un altro file, altrimenti al prossimo update del gioco li perdi!" />

        </Grid>

        <TabControl
            x:Name="tabControl"
            Margin="5"
            ItemsSource="{Binding TraslatedStrings}">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Header" Value="{Binding Key}" />
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ContentTemplate>
                <DataTemplate>

                    <ListView ItemsSource="{Binding Value}">

                        <ListView.View>

                            <GridView AllowsColumnReorder="False" ColumnHeaderToolTip="Puoi modificare solo il valore">

                                <GridViewColumn DisplayMemberBinding="{Binding Key}" Header="Chiave" />

                                <GridViewColumn Width="600" Header="Valore">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Width="500"
                                                Text="{Binding Value.Text}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                            </GridView>

                        </ListView.View>

                    </ListView>

                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

    </DockPanel>

</Window>
