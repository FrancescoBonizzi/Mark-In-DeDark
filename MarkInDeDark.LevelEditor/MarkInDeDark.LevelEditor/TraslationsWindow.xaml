<Window
    x:Class="MarkInDeDark.LevelEditor.TraslationsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MarkInDeDark.LevelEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Traduzioni"
    Width="800"
    Height="450"
    Closing="Window_Closing"
    mc:Ignorable="d">

    <DockPanel Background="AliceBlue">

        <Menu DockPanel.Dock="Top">

            <MenuItem
                x:Name="btnSalvaTutto"
                Click="btnSalvaTutto_Click"
                Header="Salva tutto" />

        </Menu>


        <TabControl x:Name="tabControl" Margin="5" ItemsSource="{Binding TraslatedStrings}">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Header" Value="{Binding Key}" />
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ContentTemplate>
                <DataTemplate>

                    <ListView ItemsSource="{Binding Value}">

                        <ListView.View>

                            <GridView AllowsColumnReorder="False" ColumnHeaderToolTip="Puoi modificare solo il valore">

                                <GridViewColumn
                                    Width="100"
                                    DisplayMemberBinding="{Binding Key}"
                                    Header="Chiave" />

                                <GridViewColumn Header="Valore" Width="600">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value.Text}" Width="500" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                            </GridView>

                        </ListView.View>

                    </ListView>

                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

    </DockPanel>

</Window>
