<Window
    x:Class="MarkInDeDark.LevelEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MarkInDeDark.LevelEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="Mark in DeDark - Level editor"
    Width="1920"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    PreviewKeyDown="LevelEditorCanvas_PreviewKeyDown"
    ResizeMode="CanResize"
    mc:Ignorable="d">

    <Grid Background="AliceBlue">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">

            <MenuItem Header="File">
                <MenuItem
                    x:Name="btnNuovo"
                    Click="BtnNuovo_Click"
                    Header="Nuovo">

                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE17C;" />
                    </MenuItem.Icon>

                </MenuItem>
                <Separator />
                <MenuItem
                    x:Name="btnApri"
                    Click="BtnApri_Click"
                    Header="Apri">

                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE1A5;" />
                    </MenuItem.Icon>

                </MenuItem>
                <Separator />
                <MenuItem
                    x:Name="btnSalva"
                    Click="BtnSalva_Click"
                    Header="Salva">

                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE105;" />
                    </MenuItem.Icon>

                </MenuItem>
                <MenuItem
                    x:Name="btnSalvaCopia"
                    Click="BtnSalvaCopia_Click"
                    Header="Salva una copia">

                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE159;" />
                    </MenuItem.Icon>

                </MenuItem>
                <Separator />
                <MenuItem
                    x:Name="btnImpostaPathGioco"
                    Click="BtnImpostaPathGioco_Click"
                    Header="Imposta percorso del gioco">

                    <MenuItem.Icon>
                        <Image Width="15" Source="Assets/icons/player_front_iddle.png" />
                    </MenuItem.Icon>

                </MenuItem>
            </MenuItem>

            <MenuItem Header="Strumenti">
                <MenuItem
                    x:Name="btnProvaInGame"
                    Click="BtnProvaInGame_Click"
                    Header="Prova in game">

                    <MenuItem.Icon>
                        <Image Width="15" Source="Assets/icons/player_front_iddle.png" />
                    </MenuItem.Icon>

                </MenuItem>

                <MenuItem
                    x:Name="btnCambiaSettingsGioco"
                    Click="BtnCambiaSettingsGioco_Click"
                    Header="Cambia impostazioni di gioco">

                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE115;" />
                    </MenuItem.Icon>

                </MenuItem>

                <MenuItem
                    x:Name="btnTraduzioni"
                    Click="btnTraduzioni_Click"
                    Header="Gestione testi">

                    <MenuItem.Icon>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Times New Roman"
                            FontSize="14"
                            FontStyle="Italic"
                            FontWeight="Bold"
                            Text="A" />
                    </MenuItem.Icon>

                </MenuItem>
            </MenuItem>

        </Menu>

        <Grid Grid.Row="1">

            <StackPanel Orientation="Vertical">

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="100"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Terreno: " />

                    <Button
                        x:Name="helpGround"
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpGround_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        x:Name="btnNonCella"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Una non cella. Non verrà disegnato nulla all'interno.">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Black" />
                            <TextBlock Padding="2,2" Text="Non cella" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="btnBuio"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="7"
                        ToolTip="Una cella buia. I muri vengono disegnati intorno.">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Gray" />
                            <TextBlock Padding="2,2" Text="Buio" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnGroundType_Ground"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Disegna una cella sui il personaggio può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Brown" />
                            <TextBlock Padding="2,2" Text="Terra" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnGroundType_Ground2"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="6"
                        ToolTip="Disegna una cella di tipo 2 sui il personaggio può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="SandyBrown" />
                            <TextBlock Padding="2,2" Text="Terra tipo 2" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnGroundType_Ground3"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="9"
                        ToolTip="Disegna una cella di tipo 3 sui il personaggio può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="RosyBrown" />
                            <TextBlock Padding="2,2" Text="Terra tipo 3" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnGroundType_Ground4"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="10"
                        ToolTip="Disegna una cella di tipo 4 sui il personaggio può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="LightCoral" />
                            <TextBlock Padding="2,2" Text="Terra tipo 4" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnGroundType_Ground5"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="11"
                        ToolTip="Disegna una cella di tipo 5 sui il personaggio può camminare">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="BlanchedAlmond" />
                            <TextBlock Padding="2,2" Text="Terra tipo 5" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnGroundType_Ground8"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="8"
                        ToolTip="Disegna una cella per riempimento">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Navy" />
                            <TextBlock Padding="2,2" Text="Riempimento" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="3"
                        ToolTip="Imposta una trappola a morte istantanea">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Fuchsia" />
                            <TextBlock Padding="2,2" Text="Trappola ist." />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="4"
                        ToolTip="Imposta una trappola con botola">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Aqua" />
                            <TextBlock Padding="2,2" Text="Trappola dt" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnGroundType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="5"
                        ToolTip="Trigger per far apparire il Goblin">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Fill="Lime" />
                            <TextBlock Padding="2,2" Text="Goblin trigger" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="100"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Muri: " />

                    <Button
                        x:Name="helpWalls"
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpWalls_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        x:Name="BtnWallType_No"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Cancella il muro">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Black" />
                            <TextBlock Padding="2,2" Text="No muro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnWallType_Standard"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Disegna un muro che non potrà essere oltrepassato">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Green" />
                            <TextBlock Padding="2,2" Text="Muro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnWallType_Special1"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="4"
                        ToolTip="Disegna il muro speciale di questo pacco di livelli">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Yellow" />
                            <TextBlock Padding="2,2" Text="Muro spec. 1" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnWallType_Special2"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="12"
                        ToolTip="Disegna il muro speciale di questo pacco di livelli">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Gold" />
                            <TextBlock Padding="2,2" Text="Muro spec. 2" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnWallType_Special3"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="13"
                        ToolTip="Disegna il muro speciale di questo pacco di livelli">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Fuchsia" />
                            <TextBlock Padding="2,2" Text="Muro spec. 3" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnWallType_Special4"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="14"
                        ToolTip="Disegna il muro speciale di questo pacco di livelli">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Coral" />
                            <TextBlock Padding="2,2" Text="Muro spec. 4" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnWallType_Special5"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="15"
                        ToolTip="Disegna il muro speciale di questo pacco di livelli">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="DarkKhaki" />
                            <TextBlock Padding="2,2" Text="Muro spec. 5" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="2"
                        ToolTip="Disegna un muro che potrà essere essere distrutto">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Red" />
                            <TextBlock Padding="2,2" Text="Muro fragile" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="3"
                        ToolTip="Disegna una porta che potrà essere aperta e chiusa">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Blue" />
                            <TextBlock Padding="2,2" Text="Porta" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="5"
                        ToolTip="Disegna l'ingresso del gioco">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="White" />
                            <TextBlock Padding="2,2" Text="Muro ingresso" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="6"
                        ToolTip="Disegna l'uscita del gioco">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Aqua" />
                            <TextBlock Padding="2,2" Text="Muro uscita" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="60"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="7"
                        ToolTip="Decal 1">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="RosyBrown" />
                            <TextBlock Padding="2,2" Text="Decal 1" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="60"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="8"
                        ToolTip="Decal 2">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="MistyRose" />
                            <TextBlock Padding="2,2" Text="Decal 2" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="60"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="9"
                        ToolTip="Decal 3">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="CornflowerBlue" />
                            <TextBlock Padding="2,2" Text="Decal 3" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="60"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="10"
                        ToolTip="Decal 4">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="BlueViolet" />
                            <TextBlock Padding="2,2" Text="Decal 4" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="60"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnWallType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="11"
                        ToolTip="Decal 5">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Violet" />
                            <TextBlock Padding="2,2" Text="Decal 5" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="100"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Oggetti: " />

                    <Button
                        x:Name="helpObjects"
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpObjects_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        x:Name="BtnObjectTypeCancel"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="0"
                        ToolTip="Cancella oggetto">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle
                                Width="4"
                                Height="15"
                                Fill="Black" />
                            <TextBlock Padding="2,2" Text="Cancella" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Player"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="1"
                        ToolTip="Imposta la posizione del giocatore">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/player_front_iddle.png" />
                            <TextBlock Padding="2,2" Text="Giocatore" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Key"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="2"
                        ToolTip="Imposta la posizione della chiave d'uscita">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/key.png" />
                            <TextBlock Padding="2,2" Text="Chiave" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Exit"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="3"
                        ToolTip="Imposta la posizione dell'uscita">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/win_closed.png" />
                            <TextBlock Padding="2,2" Text="Uscita" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="4"
                        ToolTip="Imposta un pacco di candele da utilizzare">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/candle6.png" />
                            <TextBlock Padding="2,2" Text="Candele" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="12"
                        ToolTip="Imposta una luce ambientale">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/lightobject_1.png" />
                            <TextBlock Padding="2,2" Text="Lucina" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnText_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        ToolTip="Imposta una scritta che appare all'arrivo del giocatore sulla cella">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Times New Roman"
                                FontSize="14"
                                FontStyle="Italic"
                                FontWeight="Bold"
                                Text="A" />
                            <TextBlock Padding="2,2" Text="Testo" />
                        </StackPanel>
                    </RadioButton>


                    <RadioButton
                        x:Name="BtnObjectType_1"
                        Width="25"
                        Height="25"
                        Margin="10,0,0,0"
                        Background="LightCoral"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="13"
                        ToolTip="Imposta la posizione di una colonna squadrata non valicabile">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/object_unpassable_1.png" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_2"
                        Width="25"
                        Height="25"
                        Margin="10,0,0,0"
                        Background="LightCoral"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="14"
                        ToolTip="Imposta la posizione di una colonna tonda non valicabile">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/object_unpassable_2.png" />
                        </StackPanel>
                    </RadioButton>


                    <RadioButton
                        x:Name="BtnObjectType_3"
                        Width="25"
                        Height="25"
                        Margin="10,0,0,0"
                        Background="LightGreen"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="15"
                        ToolTip="Imposta la posizione di un vaso valicabile">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/object_passable_1.png" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <StackPanel Margin="0,5" Orientation="Horizontal">

                    <TextBlock
                        Width="100"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Text="Nemici: " />

                    <Button
                        Width="22"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Click="HelpEnemies_Click"
                        Content="?"
                        Cursor="Help"
                        FontWeight="Bold" />

                    <RadioButton
                        x:Name="BtnObjectType_Zombie"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="5"
                        ToolTip="Imposta la posizione dello zombie">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/zombie_front_walking_1.png" />
                            <TextBlock Padding="2,2" Text="Zombie" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Skeleton"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="6"
                        ToolTip="Imposta la posizione dello scheletro">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/skeleton_front_iddle.png" />
                            <TextBlock Padding="2,2" Text="Scheletro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Goblin"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="7"
                        ToolTip="Imposta la posizione dello scheletro">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/goblin_front_dying_1.png" />
                            <TextBlock Padding="2,2" Text="Goblin" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Taurus"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="8"
                        ToolTip="Imposta la posizione del taurus">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/taurus_front_iddle.png" />
                            <TextBlock Padding="2,2" Text="Taurus" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Ghost"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="10"
                        ToolTip="Imposta la posizione del ghost">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/ghost_back_attack_1.png" />
                            <TextBlock Padding="2,2" Text="Ghost" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BtnObjectType_Bubu"
                        Width="100"
                        Margin="10,0"
                        Padding="5,2"
                        Click="BtnObjectType_Click"
                        Cursor="Hand"
                        GroupName="PulsantiEditor"
                        Style="{StaticResource {x:Type ToggleButton}}"
                        Tag="11"
                        ToolTip="Imposta la posizione del bubu">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="Assets/icons/bubu_front_walking_1.png" />
                            <TextBlock Padding="2,2" Text="Bubu" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <Border
                    Margin="0,5"
                    Padding="0,5"
                    Background="LightYellow"
                    CornerRadius="5">
                    <StackPanel Margin="0,5" Orientation="Horizontal">

                        <TextBlock
                            Width="100"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Texture: " />

                        <Button
                            Width="22"
                            Padding="5,2"
                            VerticalAlignment="Center"
                            Click="HelpTexture_Click"
                            Content="?"
                            Cursor="Help"
                            FontWeight="Bold" />

                        <StackPanel
                            Width="220"
                            Margin="10,0"
                            Orientation="Horizontal">

                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Pacco di texture:" />

                            <ComboBox
                                x:Name="cmbTexturePack"
                                Width="100"
                                Cursor="Hand"
                                ToolTip="Indica il pacco di texture da utilizzare in questo livello">

                                <ComboBoxItem Tag="0">Pacco Debug</ComboBoxItem>
                                <ComboBoxItem Tag="1">Pacco 1</ComboBoxItem>
                                <ComboBoxItem Tag="2">Pacco 2</ComboBoxItem>
                                <ComboBoxItem Tag="3">Pacco 3</ComboBoxItem>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Margin="10,0" Orientation="Horizontal">

                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Probabilità di sporcare (%):" />

                            <xceed:IntegerUpDown
                                x:Name="numDirtyProbability"
                                Width="100"
                                Maximum="100"
                                Minimum="0"
                                ToolTip="Indica la probabilità di sporcare la texture principale del pavimento" />

                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">

            <Canvas
                Name="levelEditorCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Cursor="Pen"
                MouseDown="LevelEditorCanvas_MouseDown"
                MouseMove="LevelEditorCanvas_MouseMove" />

        </Grid>

    </Grid>

</Window>
