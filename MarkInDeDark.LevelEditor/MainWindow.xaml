                        Header="Gestione testi">

                        <MenuItem.Icon>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Times New Roman"
                                FontSize="14"
                                FontStyle="Italic"
                                FontWeight="Bold"
                                Text="A" />
                        </MenuItem.Icon>

                    </MenuItem>
                </MenuItem>

            </Menu>

        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">

            <Canvas
