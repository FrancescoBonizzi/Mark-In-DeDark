        <Grid
            x:Name="gridLoader"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Panel.ZIndex="10"
            Background="Gray"
            Opacity="0.0"
            Visibility="Collapsed">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <Image
                    Width="200"
                    Height="200"
                    Margin="50"
                    VerticalAlignment="Center"
                    Source="Assets/icons/setting.png" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="80"
                    Foreground="White"
                    Text="Caricamento in corso..." />

            </StackPanel>

        </Grid>

        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="&gt; Probabilità di sporcare (%):" />

                        <xceed:IntegerUpDown
                            x:Name="numDirtyProbability"
                            Width="100"
                            Maximum="100"
                            Minimum="0"
                            ToolTip="Indica la probabilità di sporcare la texture principale del pavimento" />

                    </StackPanel>

                    <StackPanel
                        Width="270"
                        Margin="30,0"
                        Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="&gt; Pacco di texture:" />

                        <ComboBox
                            x:Name="cmbTexturePack"
                            Width="100"
                            Cursor="Hand"
                            ToolTip="Indica il pacco di texture da utilizzare in questo livello">

                            <ComboBoxItem Tag="1">Pacco 1</ComboBoxItem>
                            <ComboBoxItem Tag="2">Pacco 2</ComboBoxItem>
                            <ComboBoxItem Tag="3">Pacco 3</ComboBoxItem>
                            <ComboBoxItem Tag="4">Pacco 4</ComboBoxItem>
                            <ComboBoxItem Tag="5">Pacco 5</ComboBoxItem>
                            <ComboBoxItem Tag="6">Pacco 6</ComboBoxItem>
                            <ComboBoxItem Tag="7">Pacco 7</ComboBoxItem>
                            <ComboBoxItem Tag="8">Pacco 8</ComboBoxItem>

                        </ComboBox>

                    </StackPanel>

                </StackPanel>

                <TextBlock
                    x:Name="txtNomeLivello"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Lucida console"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Nome livello" />

            </Grid>


            <Menu Grid.Row="0">

                <MenuItem Header="File">
                    <MenuItem
                        x:Name="btnNuovo"
                        Click="BtnNuovo_Click"
                        Header="Nuovo">

                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE17C;" />
                        </MenuItem.Icon>

                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="btnApri"
                        Click="BtnApri_Click"
                        Header="Apri">

                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE1A5;" />
                        </MenuItem.Icon>

                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="btnSalva"
                        Click="BtnSalva_Click"
                        Header="Salva">

                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE105;" />
                        </MenuItem.Icon>

                    </MenuItem>
                    <MenuItem
                        x:Name="btnSalvaCopia"
                        Click="BtnSalvaCopia_Click"
                        Header="Salva una copia">

                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe UI Symbol" Text="&#xE159;" />
                        </MenuItem.Icon>

                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="btnImpostaPathGioco"
                        Click="BtnImpostaPathGioco_Click"
                        Header="Imposta percorso del gioco">

                        <MenuItem.Icon>
                            <Image Width="15" Source="Assets/icons/player_front_iddle.png" />
                        </MenuItem.Icon>

                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Strumenti">
                    <MenuItem
                        x:Name="btnProvaInGame"
